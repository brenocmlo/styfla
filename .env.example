# Senha de acesso ao painel /admin. Defina um valor forte em produção.
ADMIN_PASSWORD=""

# Segredo usado para assinar (HMAC) o cookie de sessão do /admin. Defina um valor
# aleatório e estável (ex: `openssl rand -hex 32`) — nunca comite o valor real.
