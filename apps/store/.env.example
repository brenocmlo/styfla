# Senha de acesso ao painel /admin. Defina um valor forte em produção.
ADMIN_PASSWORD=""

# Segredo usado para assinar (HMAC) o cookie de sessão do /admin. Defina um valor
# aleatório e estável (ex: `openssl rand -hex 32`) — nunca comite o valor real.
ADMIN_SESSION_SECRET=""

# -----------------------------------------------------------------------------
# GATEWAY DE PAGAMENTO STRIPE (Cartão de Crédito / PIX)
# -----------------------------------------------------------------------------
# Chave pública para o frontend (Stripe Elements / Checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Chave secreta de servidor para geração de PaymentIntents e estornos
STRIPE_SECRET_KEY="sk_test_..."

# Segredo de assinatura para validação segura de Webhooks da Stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# -----------------------------------------------------------------------------
# BANCO DE DADOS POSTGRESQL (Prisma ORM)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/styfla?schema=public"
